<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <UseWPF>true</UseWPF>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests\**;obj\**;bin\**" />
    <EmbeddedResource Remove="Tests\**;obj\**;bin\**" />
    <None Remove="Tests\**;obj\**;bin\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Using Include="HdmAutomation.Automation" />
    <Using Include="HdmAutomation.Ocr" />
    <Using Include="HdmAutomation.WindowManager" />
  </ItemGroup>

  <ItemGroup>
    <None Include="OCR\data\*.traineddata" Link="OCR\data\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
