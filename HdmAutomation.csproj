<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Tests/**" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <PackageReference Include="Tesseract" Version="5.2.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="HdmAutomation.Automation" />
    <Using Include="HdmAutomation.Data" />
    <Using Include="HdmAutomation.Desktop" />
    <Using Include="HdmAutomation.Input" />
    <Using Include="HdmAutomation.Interop" />
    <Using Include="HdmAutomation.Lists" />
    <Using Include="HdmAutomation.Ocr" />
  </ItemGroup>

  <ItemGroup>
    <None Include="tessdata\*.traineddata" Link="tessdata\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
