<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Use only nuget.org for this repo, ignoring any other sources configured on the machine (e.g. Telerik). -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
